{
  "name": "arena-futvolei",
  "version": "0.1.0",
  "private": true,
  "description": "Organizador leve para escola de futevolei",
  "scripts": {
    "start": "node --no-warnings server/index.js",
    "dev": "node --no-warnings --watch server/index.js",
    "live": "serve . -l 4280",
    "static": "npx serve .",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "check": "node --check app.js && node --check server/db.js && node --check server/index.js",
    "visual:check": "node scripts/visual-check.js",
    "flow:audit": "node scripts/flow-audit.js",
    "accessibility:audit": "node scripts/accessibility-audit.js",
    "performance:audit": "node scripts/performance-audit.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "serve": "^14.2.4"
  }
}
